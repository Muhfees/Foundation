<p class="prose-serif">{{ 'Search published Nusry Foundation demonstration stories, country profiles, medical issues, events, campaigns and reports.'|t }}</p>

<form class="filter-bar" method="get" action="/search" role="search" aria-label="{{ 'Site search'|t }}">
  <div class="filter-bar__grid">
    <div class="filter-bar__field">
      <label for="search-page-q">{{ 'Search keywords'|t }}</label>
      <input id="search-page-q" type="search" name="q" value="{{ query }}" maxlength="200" placeholder="{{ 'e.g. maternal, water, report...'|t }}">
    </div>
    <div class="filter-bar__field">
      <label for="search-page-type">{{ 'Content type'|t }}</label>
      <select id="search-page-type" name="type">
        <option value="">{{ 'All types'|t }}</option>
        {% for key, label in options.types %}
          <option value="{{ key }}" {{ filters.type == key ? 'selected' }}>{{ label }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="filter-bar__field">
      <label for="search-page-country">{{ 'Country (Illustrative)'|t }}</label>
      <select id="search-page-country" name="country">
        <option value="">{{ 'All countries'|t }}</option>
        {% for id, name in options.countries %}
          <option value="{{ id }}" {{ filters.country == (id ~ '') ? 'selected' }}>{{ name }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="filter-bar__field">
      <label for="search-page-issue">{{ 'Medical issue'|t }}</label>
      <select id="search-page-issue" name="issue">
        <option value="">{{ 'All issues'|t }}</option>
        {% for id, name in options.issues %}
          <option value="{{ id }}" {{ filters.issue == (id ~ '') ? 'selected' }}>{{ name }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="filter-bar__field">
      <label for="search-page-sort">{{ 'Sort by'|t }}</label>
      <select id="search-page-sort" name="sort">
        <option value="relevance" {{ filters.sort == 'relevance' ? 'selected' }}>{{ 'Most relevant'|t }}</option>
        <option value="recent" {{ filters.sort == 'recent' ? 'selected' }}>{{ 'Most recent'|t }}</option>
      </select>
    </div>
    <div class="filter-bar__actions">
      <button type="submit" class="btn btn--primary">{{ 'Search'|t }}</button>
      <a class="btn btn--outline-dark" href="/search">{{ 'Clear'|t }}</a>
    </div>
  </div>
</form>

{% if active_filters %}
  <div class="active-filters" aria-label="{{ 'Active search filters'|t }}">
    {% for chip in active_filters %}
      <span class="filter-chip">{{ chip }}</span>
    {% endfor %}
    <a class="link-chevron" href="/search">{{ 'Reset'|t }}</a>
  </div>
{% endif %}

{% if status == 'validation_error' or status == 'unavailable' %}
  <div class="state-banner state-banner--error" role="alert">
    <strong>{{ status == 'unavailable' ? 'Search index unavailable:'|t : 'Invalid search input:'|t }}</strong>
    {{ error }}
  </div>
{% else %}
  <p class="results-summary" role="status" aria-live="polite">
    {{ 'Found @count published results.'|t({'@count': total}) }}
  </p>

  {% if items is empty %}
    <div class="state-banner">
      <p>{{ 'No published results matched your search. Try fewer keywords or reset your filters.'|t }}</p>
      <p style="margin-top: 12px;"><a class="btn btn--outline-dark" href="/search">{{ 'Reset search'|t }}</a></p>
    </div>
  {% else %}
    <div class="search-results">
      {% for item in items %}
        <article class="search-result">
          <div class="listing-card__meta">
            {{ item.type_label }}{% if item.date %} | {{ item.date }}{% endif %}
          </div>
          <h2 class="listing-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h2>
          <p>{{ item.excerpt }}</p>
        </article>
      {% endfor %}
    </div>
  {% endif %}
{% endif %}

{% if pages > 1 %}
  <nav class="pagination" aria-label="{{ 'Search results pagination'|t }}">
    {% for p in 0..(pages - 1) %}
      {% set qs = filters|merge({'q': query, 'page': p}) %}
      <a class="pagination__link"
         href="/search?{{ qs|url_encode }}"
         {% if p == page %}aria-current="page"{% endif %}>
        {{ p + 1 }}
      </a>
    {% endfor %}
  </nav>
{% endif %}
