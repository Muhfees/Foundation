<?php

/**
 * @file
 * Install and schema hooks for the Nusry Forms module.
 */

/**
 * Implements hook_schema().
 */
function nusry_forms_schema(): array {
  $schema['nusry_newsletter_subscriptions'] = [
    'description' => 'Stores simulated double opt-in newsletter records (demo only).',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'email' => ['type' => 'varchar', 'length' => 254, 'not null' => TRUE],
      'email_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'sms_opt_in' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'phone' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'status' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE, 'default' => 'pending'],
      'token_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'token_expires' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'unsub_token_hash' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'created' => ['type' => 'int', 'not null' => TRUE],
      'confirmed' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'unsubscribed' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'email_hash' => ['email_hash'],
    ],
    'indexes' => [
      'token_hash' => ['token_hash'],
      'unsub_token_hash' => ['unsub_token_hash'],
      'status' => ['status'],
    ],
  ];

  $schema['nusry_contact_submissions'] = [
    'description' => 'Restricted demo contact inquiry storage (never publicly exposed).',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'sender_name' => ['type' => 'varchar', 'length' => 120, 'not null' => TRUE],
      'sender_email' => ['type' => 'varchar', 'length' => 254, 'not null' => TRUE],
      'topic' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'message' => ['type' => 'text', 'size' => 'normal', 'not null' => TRUE],
      'consent_ack' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 1],
      'created' => ['type' => 'int', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'created' => ['created'],
    ],
  ];

  return $schema;
}
