<?php

/**
 * @file
 * Install and schema definitions for synthetic demo donations.
 */

/**
 * Implements hook_schema().
 */
function nusry_donations_schema(): array {
  $schema['nusry_donations'] = [
    'description' => 'Stores synthetic demonstration donations and mock recurring state.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'reference' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'idempotency_key' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'donor_name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'donor_email' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'amount_minor' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'currency' => [
        'type' => 'varchar',
        'length' => 3,
        'not null' => TRUE,
        'default' => 'USD',
      ],
      'frequency' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'once',
      ],
      'campaign_id' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => 'DEMO-MAT-2025',
      ],
      'tribute_type' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'none',
      ],
      'tribute_name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'employer_match' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'payment_method' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'demo_card',
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'completed',
      ],
      'recurring_active' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'updated' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'reference' => ['reference'],
      'idempotency_key' => ['idempotency_key'],
    ],
    'indexes' => [
      'uid' => ['uid'],
      'status' => ['status'],
    ],
  ];
  return $schema;
}
